@@ -0,0 +1,132 @@
+//! WOPI-style host integration for the web build.
+//!
+//! When the app is embedded by a cloud host (e.g. tup-cloud), the iframe URL
+//! carries `?wopi=<file endpoint>&access_token=<token>`. The endpoint speaks a
+//! WOPI-like protocol, the same shape Collabora Online uses:
+//!
+//! - `GET  {wopi}?access_token=…`           → file info JSON (`BaseFileName`)
+//! - `GET  {wopi}/contents?access_token=…`  → file bytes
+//! - `POST {wopi}/contents?access_token=…`  → save file bytes back
+//!
+//! With a session present the drawing is fetched and opened automatically at
+//! boot, and plain Save (QSAVE / Ctrl+S) uploads back to the host instead of
+//! triggering a browser download. Save As keeps the download behaviour.
+
+use std::cell::RefCell;
+use std::path::PathBuf;
+
+use wasm_bindgen::JsCast;
+use wasm_bindgen_futures::JsFuture;
+
+use acadrust::CadDocument;
+
+use crate::scene::DerivedCaches;
+
+thread_local! {
+    /// The host file name from CheckFileInfo, once fetched. Doubles as the
+    /// "session is live" flag for the save path.
+    static WOPI_NAME: RefCell<Option<String>> = const { RefCell::new(None) };
+}
+
+/// `(wopi_src, access_token)` from the page URL, if the host embedded us.
+pub fn session_params() -> Option<(String, String)> {
+    let search = web_sys::window()?.location().search().ok()?;
+    let query = search.strip_prefix('?').unwrap_or(&search);
+    let mut src = None;
+    let mut token = None;
+    for pair in query.split('&') {
+        let (key, value) = pair.split_once('=')?;
+        let decoded = js_sys::decode_uri_component(value).ok()?.as_string()?;
+        match key {
+            "wopi" => src = Some(decoded),
+            "access_token" => token = Some(decoded),
+            _ => {}
+        }
+    }
+    Some((src?, token?))
+}
+
+/// True once a WOPI file has been opened — Save then uploads to the host.
+pub fn active() -> bool {
+    WOPI_NAME.with(|n| n.borrow().is_some())
+}
+
+/// The host-side file name (e.g. `part.dwg`) of the active session.
+pub fn file_name() -> Option<String> {
+    WOPI_NAME.with(|n| n.borrow().clone())
+}
+
+async fn fetch_response(url: &str) -> Result<web_sys::Response, String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let resp_val = JsFuture::from(window.fetch_with_str(url))
+        .await
+        .map_err(|_| "fetch failed".to_string())?;
+    let resp: web_sys::Response = resp_val.dyn_into().map_err(|_| "not a Response")?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    Ok(resp)
+}
+
+/// Fetch file info + bytes, parse the drawing and build the caches — the same
+/// payload as `pick_and_load_web`, so it feeds `Message::FileOpened` directly.
+pub async fn load_wopi_web(
+) -> Result<(String, PathBuf, CadDocument, DerivedCaches), String> {
+    let (src, token) = session_params().ok_or("no WOPI session in URL")?;
+
+    // CheckFileInfo → the real file name (drives the parser's format choice).
+    let info = fetch_response(&format!("{src}?access_token={token}")).await?;
+    let text = JsFuture::from(info.text().map_err(|_| "text() unavailable")?)
+        .await
+        .map_err(|_| "file info read failed")?;
+    let body = text.as_string().ok_or("file info is not a string")?;
+    let json: serde_json::Value =
+        serde_json::from_str(&body).map_err(|e| e.to_string())?;
+    let name = json["BaseFileName"]
+        .as_str()
+        .unwrap_or("drawing.dwg")
+        .to_string();
+
+    // GetFile → the drawing bytes.
+    let resp = fetch_response(&format!("{src}/contents?access_token={token}")).await?;
+    let buf = JsFuture::from(
+        resp.array_buffer().map_err(|_| "array_buffer unavailable")?,
+    )
+    .await
+    .map_err(|_| "body read failed")?;
+    let bytes = js_sys::Uint8Array::new(&buf).to_vec();
+
+    let mut doc = super::load_bytes(&name, bytes)?;
+    let dropped = super::purge_corrupt_entities(&mut doc);
+    let mut caches = crate::scene::build_derived_caches(&doc);
+    caches.corrupt_dropped = dropped;
+
+    WOPI_NAME.with(|n| *n.borrow_mut() = Some(name.clone()));
+    let path = PathBuf::from(&name);
+    Ok((name, path, doc, caches))
+}
+
+/// PutFile: upload the serialized drawing back to the host.
+pub async fn put_wopi_file(bytes: Vec<u8>) -> Result<(), String> {
+    let (src, token) = session_params().ok_or("no WOPI session in URL")?;
+    let window = web_sys::window().ok_or("no window")?;
+
+    let array = js_sys::Uint8Array::from(bytes.as_slice());
+    let init = web_sys::RequestInit::new();
+    init.set_method("POST");
+    init.set_body(&array.into());
+    let request = web_sys::Request::new_with_str_and_init(
+        &format!("{src}/contents?access_token={token}"),
+        &init,
+    )
+    .map_err(|_| "bad request".to_string())?;
+
+    let resp_val = JsFuture::from(window.fetch_with_request(&request))
+        .await
+        .map_err(|_| "save upload failed".to_string())?;
+    let resp: web_sys::Response = resp_val.dyn_into().map_err(|_| "not a Response")?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    Ok(())
+}
