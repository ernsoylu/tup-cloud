+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Signex EDA</title>
+    <link
+      data-trunk
+      rel="rust"
+      href="crates/signex-app/Cargo.toml"
+      data-bin="signex"
+      data-wasm-opt="1"
+      data-wasm-opt-params="--all-features"
+    />
+    <style>
+      /* The iced shell appends one <canvas> per window to <body>; the first
+         one is the main workspace window — let it fill the viewport. */
+      html,
+      body {
+        margin: 0;
+        padding: 0;
+        width: 100%;
+        height: 100%;
+        overflow: hidden;
+        background: #1a1b1e;
+      }
+      canvas {
+        display: block;
+        width: 100%;
+        height: 100%;
+        outline: none;
+      }
+      #signex-loading {
+        position: fixed;
+        inset: 0;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+        color: #8a8f98;
+        font: 14px system-ui, sans-serif;
+        pointer-events: none;
+      }
+    </style>
+  </head>
+  <body>
+    <div id="signex-loading">Loading Signex…</div>
+    <script>
+      // Remove the loading hint once the app's first canvas appears.
+      new MutationObserver((_, observer) => {
+        if (document.querySelector("canvas")) {
+          document.getElementById("signex-loading")?.remove();
+          observer.disconnect();
+        }
+      }).observe(document.body, { childList: true });
+    </script>
+  </body>
+</html>
