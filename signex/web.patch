+//! Web-build (wasm32) compatibility shims.
+//!
+//! The browser has no real file paths, no folder picker and no XDG config
+//! directories. These shims keep the native dialog / persistence code paths
+//! compiling on wasm32 with the smallest possible diff; the affected flows
+//! degrade gracefully at runtime (fs calls error and surface through normal
+//! error reporting, folder pickers behave as cancelled, preferences stay
+//! session-local).
+
+#[cfg(target_arch = "wasm32")]
+mod wasm {
+    use std::path::PathBuf;
+
+    /// rfd's wasm `FileHandle` has no `path()` — browser files are
+    /// pathless. Modelling the handle as a bare-filename path keeps the
+    /// `.path().to_path_buf()` call sites compiling unchanged. On native
+    /// this trait is never resolved: the inherent `path()` wins.
+    pub trait FileHandlePath {
+        fn path(&self) -> PathBuf;
+    }
+
+    impl FileHandlePath for rfd::FileHandle {
+        fn path(&self) -> PathBuf {
+            PathBuf::from(self.file_name())
+        }
+    }
+
+    /// Browsers cannot pick directories through rfd — behave as if the
+    /// user cancelled the dialog.
+    pub trait DialogFolders {
+        fn pick_folder(self) -> std::future::Ready<Option<rfd::FileHandle>>;
+    }
+
+    impl DialogFolders for rfd::AsyncFileDialog {
+        fn pick_folder(self) -> std::future::Ready<Option<rfd::FileHandle>> {
+            std::future::ready(None)
+        }
+    }
+
+    /// `dirs` stand-in — no config directory in the browser, so every
+    /// consumer takes its existing "no config dir" fallback path.
+    pub mod dirs {
+        use std::path::PathBuf;
+
+        pub fn config_dir() -> Option<PathBuf> {
+            None
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub use wasm::*;
