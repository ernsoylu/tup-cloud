diff --git a/Trunk.toml b/Trunk.toml
new file mode 100644
index 0000000..d080aaf
--- /dev/null
+++ b/Trunk.toml
@@ -0,0 +1,10 @@
+# Web build — `trunk build --release` produces dist/ (see also
+# RUSTFLAGS: the getrandom 0.3 wasm backend must be selected via cfg).
+[build]
+target = "index.html"
+
+[tools]
+# trunk's default binaryen rejects the bulk-memory ops rustc 1.97 emits even
+# with the --all-features param the index.html link passes; pin a current
+# release that understands them.
+wasm_opt = "version_124"
diff --git a/crates/signex-app/Cargo.toml b/crates/signex-app/Cargo.toml
index 7e9a49c..3eb6509 100644
--- a/crates/signex-app/Cargo.toml
+++ b/crates/signex-app/Cargo.toml
@@ -31,13 +31,9 @@ signex-erc = { workspace = true }
 signex-erc-dsl = { workspace = true }
 signex-net = { workspace = true }
 signex-output = { workspace = true }
-signex-library = { workspace = true, features = [
-    "local-git",
-    "database",
-    "distributors-community",
-    "ai-stub",
-    "search-tantivy",
-] }
+# Core only here: the adapter features (git2, tantivy, keyring, blocking
+# reqwest) do not build for wasm32 — the native target section re-adds them.
+signex-library = { workspace = true }
 signex-sketch = { workspace = true }
 signex-bake = { workspace = true }
 # `log` feature: signex-app installs a `log`-based logger (SignexLogger) but
@@ -61,12 +57,45 @@ image = { version = "0.25", default-features = false, features = ["png"] }
 # the order-of-preference list. `tokio` is already a transitive dep
 # (iced) but we use the multi-thread runtime explicitly for the OAuth
 # exchange + Mouser test flow on a worker thread.
+toml = { workspace = true }
+
+[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
+iced = { workspace = true, features = ["tokio"] }
+signex-library = { workspace = true, features = [
+    "local-git",
+    "database",
+    "distributors-community",
+    "ai-stub",
+    "search-tantivy",
+] }
 webbrowser = "1"
 tiny_http = "0.12"
 dirs = "5"
-toml = { workspace = true }
 tokio = { workspace = true }
 
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+# WebGL2 fallback: without it wgpu-on-wasm is WebGPU-only and the app cannot
+# start on browsers that lack (or blocklist) WebGPU. With both compiled in,
+# wgpu picks WebGPU when navigator.gpu exists and falls back to GL otherwise.
+iced = { workspace = true, features = ["webgl"] }
+console_error_panic_hook = "0.1"
+console_log = "1"
+signex-library = { workspace = true, features = ["ai-stub"] }
+uuid = { workspace = true, features = ["js"] }
+wasm-bindgen = "0.2"
+wasm-bindgen-futures = "0.4"
+js-sys = "0.3"
+web-sys = { version = "0.3", features = [
+    "Window",
+    "Location",
+    "Request",
+    "RequestInit",
+    "Response",
+] }
+# Transitive RNG backends need their JS shims switched on for the browser.
+getrandom02 = { package = "getrandom", version = "0.2", features = ["js"] }
+getrandom = { version = "0.3", features = ["wasm_js"] }
+
 [dev-dependencies]
 tempfile = "3"
 wiremock = "0.6"
