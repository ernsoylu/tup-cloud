+//! Web-build stand-in for the `local-git` adapter.
+//!
+//! `git2` (vendored libgit2, C) does not build for wasm32, so the web build
+//! compiles without the `local-git` feature. signex-app, however, references
+//! the adapter unconditionally across its library subsystem. This stub keeps
+//! those call sites compiling with the same names and signatures; every
+//! constructor fails with a "not available in the web build" error, so no
+//! adapter value ever exists at runtime and the inherent accessors are
+//! unreachable.
+
+use std::path::Path;
+
+use crate::adapter::{LibraryAdapter, LibraryError};
+use crate::library_file::SnxlibManifest;
+use crate::manifest::Manifest;
+
+pub(crate) fn unsupported() -> LibraryError {
+    LibraryError::Backend("local file libraries are not available in the web build".into())
+}
+
+/// Mirror of the native `LibraryInitOptions` (dep-free, so duplicated
+/// verbatim rather than cfg-juggled out of the native module).
+#[derive(Debug, Default, Clone, Copy)]
+pub struct LibraryInitOptions {
+    pub enable_git: bool,
+    pub use_lfs: bool,
+}
+
+#[derive(Debug)]
+pub struct LocalGitAdapter;
+
+impl LocalGitAdapter {
+    pub fn init(
+        _file_path: impl AsRef<Path>,
+        _snx_manifest: SnxlibManifest,
+        _opts: LibraryInitOptions,
+    ) -> Result<Self, LibraryError> {
+        Err(unsupported())
+    }
+
+    pub fn open(_file_path: impl AsRef<Path>) -> Result<Self, LibraryError> {
+        Err(unsupported())
+    }
+
+    pub fn recover_init(_file_path: impl AsRef<Path>) -> Result<Self, LibraryError> {
+        Err(unsupported())
+    }
+
+    pub fn root(&self) -> &Path {
+        unreachable!("LocalGitAdapter cannot be constructed in the web build")
+    }
+
+    pub fn file_path_buf(&self) -> &Path {
+        unreachable!("LocalGitAdapter cannot be constructed in the web build")
+    }
+}
+
+impl LibraryAdapter for LocalGitAdapter {
+    fn manifest(&self) -> &Manifest {
+        unreachable!("LocalGitAdapter cannot be constructed in the web build")
+    }
+}
+
+pub mod project {
+    use std::path::{Path, PathBuf};
+
+    use super::unsupported;
+    use crate::adapter::{HistoryEntry, LibraryError};
+
+    /// Opaque stand-in for `git2::Oid` — callers only display it.
+    #[derive(Debug, Clone, Copy)]
+    pub struct CommitOid;
+
+    impl std::fmt::Display for CommitOid {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            f.write_str("0000000000000000000000000000000000000000")
+        }
+    }
+
+    #[derive(Debug)]
+    pub struct LocalGitProjectAdapter;
+
+    impl LocalGitProjectAdapter {
+        pub fn open_or_init(_project_root: PathBuf) -> Result<Self, LibraryError> {
+            Err(unsupported())
+        }
+
+        pub fn commit_path(
+            &self,
+            _rel_path: &Path,
+            _message: &str,
+        ) -> Result<CommitOid, LibraryError> {
+            Err(unsupported())
+        }
+
+        pub fn commit_external_change(
+            &self,
+            _abs_path: &Path,
+            _message: &str,
+        ) -> Result<CommitOid, LibraryError> {
+            Err(unsupported())
+        }
+
+        pub fn file_history(
+            &self,
+            _rel_path: &Path,
+            _limit: usize,
+        ) -> Result<Vec<HistoryEntry>, LibraryError> {
+            Err(unsupported())
+        }
+
+        pub fn restore_at_from_sha(&self, _rel_path: &Path, _sha: &str) -> Result<(), LibraryError> {
+            Err(unsupported())
+        }
+
+        pub fn write_gitattributes(&self, _use_lfs: bool) -> Result<(), LibraryError> {
+            Err(unsupported())
+        }
+
+        pub fn project_root(&self) -> &Path {
+            unreachable!("LocalGitProjectAdapter cannot be constructed in the web build")
+        }
+    }
+}
