diff --git a/crates/signex-app/src/web_wopi.rs b/crates/signex-app/src/web_wopi.rs
new file mode 100644
index 0000000..5289837
--- /dev/null
+++ b/crates/signex-app/src/web_wopi.rs
@@ -0,0 +1,131 @@
+//! WOPI-style host integration for the web build.
+//!
+//! When the app is embedded by a cloud host (e.g. tup-cloud), the iframe URL
+//! carries `?wopi=<file endpoint>&access_token=<token>`. The endpoint speaks
+//! a WOPI-like protocol — the same shape Collabora Online uses:
+//!
+//! - `GET  {wopi}?access_token=…`           → file info JSON (`BaseFileName`)
+//! - `GET  {wopi}/contents?access_token=…`  → file text (`.snx*` are text)
+//! - `POST {wopi}/contents?access_token=…`  → save file text back
+//!
+//! With a session present the document is fetched and opened automatically at
+//! boot, and plain Save (Ctrl+S) uploads back to the host instead of writing
+//! to the (nonexistent) local filesystem.
+
+#![cfg(target_arch = "wasm32")]
+
+use std::cell::RefCell;
+
+use wasm_bindgen::{JsCast, JsValue};
+use wasm_bindgen_futures::JsFuture;
+
+thread_local! {
+    /// The host file name once a WOPI document was opened successfully.
+    /// Doubles as the "session is live" flag for the save path.
+    static WOPI_NAME: RefCell<Option<String>> = const { RefCell::new(None) };
+}
+
+/// `(wopi_src, access_token)` from the page URL, if the host embedded us.
+pub fn session_params() -> Option<(String, String)> {
+    let search = web_sys::window()?.location().search().ok()?;
+    let query = search.strip_prefix('?').unwrap_or(&search);
+    let mut src = None;
+    let mut token = None;
+    for pair in query.split('&') {
+        let (key, value) = pair.split_once('=')?;
+        let decoded = js_sys::decode_uri_component(value).ok()?.as_string()?;
+        match key {
+            "wopi" => src = Some(decoded),
+            "access_token" => token = Some(decoded),
+            _ => {}
+        }
+    }
+    Some((src?, token?))
+}
+
+/// True once a WOPI document is open — Save then uploads to the host.
+pub fn active() -> bool {
+    WOPI_NAME.with(|n| n.borrow().is_some())
+}
+
+/// The host-side file name (e.g. `board.snxsch`) of the active session.
+pub fn file_name() -> Option<String> {
+    WOPI_NAME.with(|n| n.borrow().clone())
+}
+
+/// Mark the session live once the fetched document actually opened.
+pub(crate) fn set_active_name(name: String) {
+    WOPI_NAME.with(|n| *n.borrow_mut() = Some(name));
+}
+
+async fn fetch_response(url: &str) -> Result<web_sys::Response, String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let resp_val = JsFuture::from(window.fetch_with_str(url))
+        .await
+        .map_err(|_| "fetch failed".to_string())?;
+    let resp: web_sys::Response = resp_val.dyn_into().map_err(|_| "not a Response")?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    Ok(resp)
+}
+
+async fn response_text(resp: web_sys::Response) -> Result<String, String> {
+    let text = JsFuture::from(resp.text().map_err(|_| "text() unavailable")?)
+        .await
+        .map_err(|_| "body read failed")?;
+    text.as_string().ok_or_else(|| "body is not a string".into())
+}
+
+/// CheckFileInfo + GetFile → `(file name, file text)`, ready for
+/// `FileMsg::WopiOpened`.
+pub async fn load_wopi() -> Result<(String, String), String> {
+    let (src, token) = session_params().ok_or("no WOPI session in URL")?;
+
+    // CheckFileInfo → the real file name (drives the parser choice).
+    let info = fetch_response(&format!("{src}?access_token={token}")).await?;
+    let body = response_text(info).await?;
+    let json: serde_json::Value = serde_json::from_str(&body).map_err(|e| e.to_string())?;
+    let name = json["BaseFileName"]
+        .as_str()
+        .unwrap_or("document.snxsch")
+        .to_string();
+
+    // GetFile → the document text.
+    let resp = fetch_response(&format!("{src}/contents?access_token={token}")).await?;
+    let text = response_text(resp).await?;
+
+    Ok((name, text))
+}
+
+/// Fetch the host's component-library bundle (same-origin; the session
+/// cookie rides along automatically). Served by tup-cloud at
+/// `/api/eda/library` — JLCPCB Basic parts mapped to Signex rows/symbols.
+pub async fn fetch_web_library() -> Result<String, String> {
+    let resp = fetch_response("/api/eda/library").await?;
+    response_text(resp).await
+}
+
+/// PutFile: upload the serialised document back to the host.
+pub async fn put_wopi(text: String) -> Result<(), String> {
+    let (src, token) = session_params().ok_or("no WOPI session in URL")?;
+    let window = web_sys::window().ok_or("no window")?;
+
+    let init = web_sys::RequestInit::new();
+    init.set_method("POST");
+    init.set_body(&JsValue::from_str(&text));
+    let request = web_sys::Request::new_with_str_and_init(
+        &format!("{src}/contents?access_token={token}"),
+        &init,
+    )
+    .map_err(|_| "bad request".to_string())?;
+
+    let resp_val = JsFuture::from(window.fetch_with_request(&request))
+        .await
+        .map_err(|_| "save upload failed".to_string())?;
+    let resp: web_sys::Response = resp_val.dyn_into().map_err(|_| "not a Response")?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    Ok(())
+}
diff --git a/crates/signex-library/src/adapters/memory.rs b/crates/signex-library/src/adapters/memory.rs
new file mode 100644
index 0000000..6ba4cec
--- /dev/null
+++ b/crates/signex-library/src/adapters/memory.rs
@@ -0,0 +1,210 @@
+//! Read-only in-memory adapter — a component library without a filesystem.
+//!
+//! Built for hosted/web deployments: the host serves a JSON *bundle*
+//! (manifest fields + typed [`ComponentRow`]s per table + [`Symbol`]s), the
+//! app fetches it and mounts a [`MemoryAdapter`] over the parsed data. Also
+//! usable anywhere a fixed, code-constructed library is handy (tests, demos).
+//!
+//! Only the read surface is implemented; every mutating default on
+//! [`LibraryAdapter`] keeps returning `Backend("… not implemented …")`.
+
+use std::collections::{BTreeMap, HashMap};
+
+use serde::Deserialize;
+use uuid::Uuid;
+
+use crate::adapter::{LibraryAdapter, LibraryError, PrimitiveSummary};
+use crate::component::ComponentRow;
+use crate::identity::{InternalPn, RowId};
+use crate::manifest::{LibraryMeta, Manifest};
+use crate::primitive::PrimitiveKind;
+use crate::primitive::symbol::Symbol;
+
+/// Serde shape of the hosted library bundle (`tup-signex-weblib/1`).
+#[derive(Debug, Clone, Deserialize)]
+pub struct LibraryBundle {
+    pub format: String,
+    pub name: String,
+    pub library_id: Uuid,
+    #[serde(default)]
+    pub description: Option<String>,
+    #[serde(default)]
+    pub tables: BTreeMap<String, Vec<ComponentRow>>,
+    #[serde(default)]
+    pub symbols: Vec<Symbol>,
+}
+
+pub const BUNDLE_FORMAT: &str = "tup-signex-weblib/1";
+
+#[derive(Debug)]
+pub struct MemoryAdapter {
+    manifest: Manifest,
+    tables: BTreeMap<String, Vec<ComponentRow>>,
+    symbols: HashMap<Uuid, Symbol>,
+}
+
+impl MemoryAdapter {
+    pub fn new(
+        name: impl Into<String>,
+        library_id: Uuid,
+        description: Option<String>,
+        tables: BTreeMap<String, Vec<ComponentRow>>,
+        symbols: impl IntoIterator<Item = Symbol>,
+    ) -> Self {
+        Self {
+            manifest: Manifest {
+                library: LibraryMeta {
+                    name: name.into(),
+                    library_id,
+                    description,
+                },
+                mode: Default::default(),
+                workflow: Default::default(),
+                users: Default::default(),
+                tables: Vec::new(),
+            },
+            tables,
+            symbols: symbols.into_iter().map(|s| (s.uuid, s)).collect(),
+        }
+    }
+
+    /// Parse a `tup-signex-weblib/1` JSON bundle into a mounted-ready adapter.
+    pub fn from_bundle_json(json: &str) -> Result<Self, LibraryError> {
+        let bundle: LibraryBundle = serde_json::from_str(json)
+            .map_err(|e| LibraryError::Backend(format!("library bundle parse: {e}")))?;
+        if bundle.format != BUNDLE_FORMAT {
+            return Err(LibraryError::Backend(format!(
+                "unsupported library bundle format {:?} (expected {BUNDLE_FORMAT})",
+                bundle.format
+            )));
+        }
+        Ok(Self::new(
+            bundle.name,
+            bundle.library_id,
+            bundle.description,
+            bundle.tables,
+            bundle.symbols,
+        ))
+    }
+
+    fn table(&self, name: &str) -> Result<&Vec<ComponentRow>, LibraryError> {
+        self.tables
+            .get(name)
+            .ok_or_else(|| LibraryError::NotFound(format!("table {name}")))
+    }
+}
+
+impl LibraryAdapter for MemoryAdapter {
+    fn manifest(&self) -> &Manifest {
+        &self.manifest
+    }
+
+    fn list_tables(&self) -> Result<Vec<String>, LibraryError> {
+        Ok(self.tables.keys().cloned().collect())
+    }
+
+    fn read_table(&self, name: &str) -> Result<Vec<ComponentRow>, LibraryError> {
+        self.table(name).cloned()
+    }
+
+    fn iter_rows(&self) -> Result<Vec<(String, ComponentRow)>, LibraryError> {
+        Ok(self
+            .tables
+            .iter()
+            .flat_map(|(t, rows)| rows.iter().map(move |r| (t.clone(), r.clone())))
+            .collect())
+    }
+
+    fn read_row(&self, table: &str, row_id: RowId) -> Result<ComponentRow, LibraryError> {
+        self.table(table)?
+            .iter()
+            .find(|r| r.row_id == row_id.0)
+            .cloned()
+            .ok_or_else(|| LibraryError::NotFound(format!("row {row_id:?} in {table}")))
+    }
+
+    fn read_row_by_pn(&self, pn: &InternalPn) -> Result<(String, ComponentRow), LibraryError> {
+        for (t, rows) in &self.tables {
+            if let Some(r) = rows.iter().find(|r| &r.internal_pn == pn) {
+                return Ok((t.clone(), r.clone()));
+            }
+        }
+        Err(LibraryError::NotFound(format!("pn {}", pn.as_str())))
+    }
+
+    fn get_symbol(&self, uuid: Uuid) -> Result<Symbol, LibraryError> {
+        self.symbols
+            .get(&uuid)
+            .cloned()
+            .ok_or_else(|| LibraryError::NotFound(format!("symbol {uuid}")))
+    }
+
+    fn list_symbols(&self) -> Result<Vec<PrimitiveSummary>, LibraryError> {
+        Ok(self
+            .symbols
+            .values()
+            .map(|s| PrimitiveSummary {
+                uuid: s.uuid,
+                name: s.name.clone(),
+                kind: PrimitiveKind::Symbol,
+                used_by_count: 0,
+            })
+            .collect())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A miniature bundle in the exact shape scripts/gen_signex_library.py
+    /// emits — guards the serde contract between generator and adapter.
+    const MINI: &str = r#"{
+        "format": "tup-signex-weblib/1",
+        "name": "Mini",
+        "library_id": "0e94ce8e-58f5-5a21-9a09-6ab84b77b070",
+        "tables": {"Resistors": [{
+            "row_id": "27b16f60-9d5b-5bb0-a3ae-9be26a988ff1",
+            "internal_pn": "JLC-C1",
+            "class": "resistor",
+            "datasheet": {"kind": "url", "url": ""},
+            "state": "Released",
+            "symbol_ref": {"library_id": "0e94ce8e-58f5-5a21-9a09-6ab84b77b070",
+                            "uuid": "9adf6390-4ceb-5f6f-9d20-2de161fe2d68"},
+            "primary_mpn": {"manufacturer": "M", "mpn": "R1", "status": "Primary"},
+            "supply": [{"distributor": "JLCPCB", "sku": "C1", "moq": 1}],
+            "parameters": {"Value": {"kind": "Text", "value": "10k"}},
+            "version": "0.0.1",
+            "released": true,
+            "created": "2026-07-21T00:00:00Z",
+            "updated": "2026-07-21T00:00:00Z"
+        }]},
+        "symbols": [{
+            "uuid": "9adf6390-4ceb-5f6f-9d20-2de161fe2d68",
+            "name": "Resistor",
+            "pins": [{"number": "1", "name": "1", "electrical": "Passive",
+                       "position": [-5.08, 0.0], "orientation": "Right", "length": 2.54}],
+            "graphics": [{"kind": {"kind": "rectangle", "from": [-2.54, -1.0], "to": [2.54, 1.0]},
+                           "stroke_width": 0.254}],
+            "designator": "R?",
+            "created": "2026-07-21T00:00:00Z",
+            "updated": "2026-07-21T00:00:00Z"
+        }]
+    }"#;
+
+    #[test]
+    fn parses_and_serves_bundle() {
+        let adapter = MemoryAdapter::from_bundle_json(MINI).expect("parse");
+        assert_eq!(adapter.list_tables().unwrap(), vec!["Resistors".to_string()]);
+        let rows = adapter.read_table("Resistors").unwrap();
+        assert_eq!(rows.len(), 1);
+        let sym = adapter.get_symbol(rows[0].symbol_ref.uuid).expect("symbol");
+        assert_eq!(sym.name, "Resistor");
+        assert_eq!(sym.pins.len(), 1);
+        let (table, row) = adapter
+            .read_row_by_pn(&"JLC-C1".parse().unwrap())
+            .expect("by pn");
+        assert_eq!(table, "Resistors");
+        assert_eq!(row.primary_mpn.mpn, "R1");
+    }
+}
