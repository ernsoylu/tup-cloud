+/// Convert a library symbol primitive + its component row into the
+/// schematic sheet's `LibSymbol` registry entry. Geometry maps 1:1 —
+/// signex-library arcs are centre+angles while sheet arcs are
+/// start/mid/end points, so those are sampled on the circle.
+fn lib_symbol_from_library(
+    lib_id: &str,
+    row: &signex_library::ComponentRow,
+    symbol: &signex_library::Symbol,
+) -> signex_types::schematic::LibSymbol {
+    use signex_library::{PinDirection as LibDir, PinOrientation, SymbolGraphicKind as Kind};
+    use signex_types::schematic as sch;
+
+    let pt = |p: &[f64; 2]| sch::Point::new(p[0], p[1]);
+
+    let graphics = symbol
+        .graphics
+        .iter()
+        .map(|g| {
+            let graphic = match &g.kind {
+                Kind::Line { from, to } => sch::Graphic::Polyline {
+                    points: vec![pt(from), pt(to)],
+                    width: g.stroke_width,
+                    fill: sch::FillType::None,
+                },
+                Kind::Rectangle { from, to } => sch::Graphic::Rectangle {
+                    start: pt(from),
+                    end: pt(to),
+                    width: g.stroke_width,
+                    fill: sch::FillType::None,
+                },
+                Kind::Circle { center, radius } => sch::Graphic::Circle {
+                    center: pt(center),
+                    radius: *radius,
+                    width: g.stroke_width,
+                    fill: sch::FillType::None,
+                },
+                Kind::Arc {
+                    center,
+                    radius,
+                    start_deg,
+                    end_deg,
+                } => {
+                    let mut end = *end_deg;
+                    while end <= *start_deg {
+                        end += 360.0;
+                    }
+                    let sample = |deg: f64| {
+                        let rad = deg.to_radians();
+                        sch::Point::new(
+                            center[0] + radius * rad.cos(),
+                            center[1] + radius * rad.sin(),
+                        )
+                    };
+                    sch::Graphic::Arc {
+                        start: sample(*start_deg),
+                        mid: sample((*start_deg + end) / 2.0),
+                        end: sample(end),
+                        width: g.stroke_width,
+                        fill: sch::FillType::None,
+                    }
+                }
+                Kind::Text {
+                    position,
+                    content,
+                    size,
+                } => sch::Graphic::Text {
+                    text: content.clone(),
+                    position: pt(position),
+                    rotation: 0.0,
+                    font_size: *size,
+                    bold: false,
+                    italic: false,
+                    justify_h: Default::default(),
+                    justify_v: Default::default(),
+                },
+                Kind::Polygon { vertices } => {
+                    let mut points: Vec<_> = vertices.iter().map(|v| pt(v)).collect();
+                    if let Some(first) = points.first().cloned() {
+                        points.push(first);
+                    }
+                    sch::Graphic::Polyline {
+                        points,
+                        width: g.stroke_width,
+                        fill: sch::FillType::None,
+                    }
+                }
+            };
+            sch::LibGraphic {
+                unit: 1,
+                body_style: 1,
+                graphic,
+            }
+        })
+        .collect();
+
+    let pins = symbol
+        .pins
+        .iter()
+        .map(|p| {
+            let rotation = match p.orientation {
+                PinOrientation::Right => 0.0,
+                PinOrientation::Up => 90.0,
+                PinOrientation::Left => 180.0,
+                PinOrientation::Down => 270.0,
+                _ => 0.0,
+            };
+            let direction = match p.electrical {
+                LibDir::Input => sch::PinDirection::Input,
+                LibDir::Output => sch::PinDirection::Output,
+                LibDir::Bidirectional => sch::PinDirection::Bidirectional,
+                LibDir::Power => sch::PinDirection::PowerInput,
+                _ => sch::PinDirection::Passive,
+            };
+            sch::LibPin {
+                unit: 1,
+                body_style: 1,
+                pin: sch::Pin {
+                    direction,
+                    shape_style: sch::PinShapeStyle::Plain,
+                    position: sch::Point::new(p.position[0], p.position[1]),
+                    rotation,
+                    length: p.length,
+                    name: p.name.clone(),
+                    number: p.number.clone(),
+                    visible: true,
+                    name_visible: p.name_visible,
+                    number_visible: p.designator_visible,
+                },
+            }
+        })
+        .collect();
+
+    let datasheet = match &row.datasheet {
+        signex_library::DatasheetRef::Url { url } => url.clone(),
+        _ => String::new(),
+    };
+    // Pin names that merely repeat the pad number (passives) are noise;
+    // named pins (B/E/C, G/S/D, A/K) are worth showing.
+    let named_pins = symbol.pins.iter().any(|p| p.name != p.number);
+
+    sch::LibSymbol {
+        id: lib_id.to_string(),
+        reference: symbol.designator.clone(),
+        value: String::new(),
+        footprint: String::new(),
+        datasheet,
+        description: symbol.description.clone(),
+        keywords: String::new(),
+        fp_filters: String::new(),
+        in_bom: true,
+        on_board: true,
+        in_pos_files: true,
+        duplicate_pin_numbers_are_jumpers: false,
+        graphics,
+        pins,
+        show_pin_numbers: true,
+        show_pin_names: named_pins,
+        pin_name_offset: 0.0,
+    }
+}
